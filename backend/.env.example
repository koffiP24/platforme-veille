# Analyse IA des veilles — désactivée par défaut.
# Les deux premières options doivent être activées pour tout appel externe.
AI_ENABLED=false
AI_ALLOW_EXTERNAL_PROCESSING=false
AI_AUTO_ANALYZE=false

# Fournisseur actif : auto, openai, gemini, claude, deepseek ou groq.
AI_PROVIDER=openai
AI_FALLBACK_PROVIDERS=gemini,claude,deepseek,openai
AI_MAX_KEY_ATTEMPTS=2
AI_ALLOW_MANUAL_FAILOVER=false

# Ne laissez renseignée que la clé du fournisseur choisi.
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4.1-mini
# GEMINI_API_KEY=
# GEMINI_API_KEYS=
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEYS=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEYS=
# DEEPSEEK_MODEL=deepseek-flash
# GROQ_API_KEY=
# GROQ_API_KEYS=
# GROQ_MODEL=llama-3.3-70b-versatile
AI_LABORATORY_CONTEXT=Laboratoire d’essais et d’étalonnage engagé dans une démarche ISO/IEC 17025.
AI_REQUEST_TIMEOUT_MS=45000

# DeepL : une clé ou plusieurs clés séparées par des virgules.
DEEPL_API_KEY=
DEEPL_API_KEYS=
